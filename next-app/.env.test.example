# Real agent credentials registered in the Vercel-deployed platform (required for PITCHR_E2E=true)
# Create an agent via POST /api/agents on the deployed instance to get these values.
ZERO_AGENT_ID=<UUID from POST /api/agents>
ZERO_API_SECRET=<apiSecret returned once on agent creation>

# Set to "true" to run live MCP tests against pitchr.studio
PITCHR_E2E=true
